# Timezone for the Jellyfin container (example: Asia/Kolkata for India)
TZ=Asia/Kolkata

# Folder on your host machine where Jellyfin stores its config files
# Example: D:/docker/jellyfin
CONFIG_ROOT=D:/docker

# Folder on your host machine where Jellyfin stores cache/temp files
# Example: D:/docker/jellyfin-cache
CACHE_ROOT=D:/docker

# Folder on your host machine containing your media library
# Example: D:/Media
MEDIA_ROOT=D:/Media
